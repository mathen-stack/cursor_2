# AI-first resume generation via OpenRouter (OpenAI-compatible API).
# Set EXPERIENCE_MODEL_API_KEY (or OPENROUTER_API_KEY) to enable the model.
# Without a key, the app falls back to deterministic rule-based generation.
EXPERIENCE_MODEL_PROVIDER=openai-compatible
EXPERIENCE_MODEL_PROVIDER_NAME=openrouter
EXPERIENCE_MODEL_API_KEY=
EXPERIENCE_MODEL_NAME=openai/gpt-4o-mini
EXPERIENCE_MODEL_BASE_URL=https://openrouter.ai/api/v1
EXPERIENCE_MODEL_TIMEOUT_MS=45000
EXPERIENCE_MODEL_MAX_RETRIES=2
EXPERIENCE_MODEL_HTTP_REFERER=
EXPERIENCE_MODEL_APP_TITLE=Resume Generator

# Force offline deterministic mode (no AI calls):
# EXPERIENCE_MODEL_PROVIDER=rule-based

# Optional JSON persistence. When omitted, development uses an in-memory store.
GENERATION_STORE_FILE=.data/experience-generation-runs.json

DATABASE_URL=

# PDF backend: portable requires no system packages. LibreOffice gives full
# Unicode and Word/PDF layout parity when soffice is available on the server.
RESUME_PDF_BACKEND=portable
LIBREOFFICE_BINARY=soffice
RESUME_PDF_TIMEOUT_MS=45000
