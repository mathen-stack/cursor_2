<Window x:Class="LiveCaptions.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Output Live Captions"
        Width="920"
        Height="310"
        MinWidth="520"
        MinHeight="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
    <Border x:Name="OverlayBorder"
            Background="#F0151922"
            BorderBrush="#556EA8FE"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StateIndicator" Width="9" Height="9" Fill="#8892A6" Margin="4,0,8,0" />
                    <TextBlock Text="OUTPUT LIVE CAPTIONS"
                               Foreground="#AAB5C8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               Foreground="#7F8BA0"
                               FontSize="11"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StartStopButton" Content="Start" Click="StartStopButton_Click" />
                    <Button Content="Clear" Click="ClearButton_Click" />
                    <Button Content="Copy all" Click="CopyButton_Click" />
                    <Button Content="Settings" Click="SettingsButton_Click" />
                    <Button Content="—" Click="MinimizeButton_Click" ToolTip="Minimize" />
                    <Button Content="✕" Click="CloseButton_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="CaptionText"
                     Grid.Row="1"
                     Text="Press Start to caption audio playing through Windows."
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     FontSize="28"
                     FontWeight="Medium"
                     CaretBrush="White"
                     SelectionBrush="#806EA8FE"
                     Margin="4,8"
                     Padding="4" />

            <Border x:Name="SettingsPanel"
                    Grid.Row="1"
                    Background="#FF1B2130"
                    BorderBrush="#40516B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="4,8"
                    Visibility="Collapsed"
                    Panel.ZIndex="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Output device" Foreground="#CAD3E1" />
                            <ComboBox x:Name="DeviceCombo" DisplayMemberPath="Name" />
                            <TextBlock Text="Recognition language (for example, en-US)" Foreground="#CAD3E1" />
                            <ComboBox x:Name="LanguageCombo" IsEditable="True">
                                <ComboBoxItem Content="en-US" />
                                <ComboBoxItem Content="en-GB" />
                                <ComboBoxItem Content="es-ES" />
                                <ComboBoxItem Content="fr-FR" />
                                <ComboBoxItem Content="de-DE" />
                                <ComboBoxItem Content="ja-JP" />
                                <ComboBoxItem Content="ko-KR" />
                                <ComboBoxItem Content="zh-CN" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Azure Speech key (never saved)" Foreground="#CAD3E1" />
                            <PasswordBox x:Name="SpeechKeyBox" Margin="0,4,0,10" Padding="6" />
                            <TextBlock Text="Azure region" Foreground="#CAD3E1" />
                            <TextBox x:Name="RegionTextBox" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Text size" Foreground="#CAD3E1" VerticalAlignment="Center" />
                                <Slider x:Name="FontSizeSlider" Minimum="18" Maximum="52" Width="130"
                                        Margin="12,0" ValueChanged="FontSizeSlider_ValueChanged" />
                                <TextBlock x:Name="FontSizeValue" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox x:Name="AutoStartCheckBox"
                                          Content="Start when opened (requires AZURE_SPEECH_KEY)"
                                          Foreground="#CAD3E1"
                                          VerticalAlignment="Center" />
                                <Button Content="Save and close" Margin="18,0,0,0" Click="SaveSettingsButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="System output only • Select text above to copy"
                       Foreground="#68758A"
                       FontSize="10"
                       Margin="7,2,0,0" />
        </Grid>
    </Border>
</Window>
