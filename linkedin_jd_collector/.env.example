# Copy to .env and fill in real values.

OPENROUTER_API_KEY=your_openrouter_api_key_here
# Free vision default (no paid credits required). Paid option: openai/gpt-4o
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Defaults to ~/Documents/LinkedIn_JD when unset
OUTPUT_DIR=

# Automation pace: human (default, watchable) or fast
AUTOMATION_PACE=human
